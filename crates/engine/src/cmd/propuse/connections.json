      "grinder", "erv", "hrv", "energy recovery", "make up air", "makeup air", "mau", "doas", "dehumidifier", "humidifier", "split system",
      "mini split", "evaporator", "kitchen hood", "range hood", "elevator", "door operator", "gate operator", "hand dryer", "dryer", "washer",
