      "manifold", "water manifold", "relief hood", "relief vent", "intake hood", "exhaust hood", "gravity hood", "gooseneck", "louver",
      "damper", "fire damper", "backdraft damper", "balancing damper", "volume damper", "manual damper", "backflow", "valve", "meter",
