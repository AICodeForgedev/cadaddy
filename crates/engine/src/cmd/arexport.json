{
  "_comment": "bim.export.ar rules (Q6207): what an AR export of the built model keeps, how it colours it and how big it may get. A job overrides any key in its building spec under `ar_export` (same shape); every list and number here is data, not code.",
  "version": 1,
  "caps": {
    "max_triangles": 300000,
    "max_bytes": 50000000,
    "max_elements": 50000,
    "source": "AR Quick Look guidance for a phone: a few hundred thousand triangles and tens of MB keep it smooth (owner 11-05 target: 300k triangles, 50 MB)"
  },
  "context": {
    "parts": ["wall", "floor", "ceiling", "soffit", "roof", "cricket", "parapet", "grid", "curtainwall", "glass", "window", "door", "column", "beam", "footing", "brace", "railing", "stair", "ground", "site"],
    "mode": "translucent",
    "opacity": 0.25,
    "source": "the building's shell and structure: shown for orientation, see-through so the trades read through it"
  },
  "skip_parts": {
    "parts": ["room"],
    "source": "a room element is a space (its floor outline), not something built"
  },
  "small_parts": {
    "parts": ["atom"],
    "mep_pieces": ["strap", "staple", "connector", "coupling", "wire", "cable", "ring", "locknut", "bushing", "clip", "hanger", "support", "bend", "fitting"],
    "max_size_mm": 30,
    "source": "the trades' loose pieces (studs, sheets, straps, staples, connectors, wire) and anything under 30 mm across: too small to see on a phone, and thousands of them"
  },
  "colors": {
    "_comment": "RGB 0-255 by the element's system (the BIM view's trade keys), then by trade group; `default` for anything else. Context parts use their own colour with the context opacity.",
    "by_system": {
      "architecture": [214, 212, 206],
      "openings": [176, 198, 212],
      "structure": [198, 168, 124],
      "site": [176, 188, 164],
      "duct_supply": [28, 144, 232],
      "duct_return": [40, 168, 92],
      "duct_exhaust": [122, 186, 58],
      "duct_outside": [0, 188, 188],
      "duct": [92, 160, 212],
      "terminals": [150, 200, 236],
      "equipment": [190, 194, 200],
      "plumbing_equipment": [150, 176, 198],
      "pipe_cold": [30, 100, 222],
      "pipe_hot": [236, 92, 38],
      "pipe_sanitary": [198, 40, 170],
      "pipe_vent": [138, 80, 202],
      "pipe_storm": [84, 122, 150],
      "pipe_gas": [232, 200, 20],
      "pipe": [40, 160, 92],
      "fixtures": [236, 240, 246],
      "fire": [222, 30, 30],
      "conduit": [246, 166, 24],
      "tray": [236, 128, 20],
      "gear": [214, 170, 96],
      "devices": [250, 212, 40],
      "lights": [255, 244, 196],
      "fire_alarm": [204, 0, 51]
    },
    "by_trade": {
      "architecture": [214, 212, 206],
      "structure": [198, 168, 124],
      "mechanical": [92, 160, 212],
      "plumbing": [40, 160, 92],
      "fire_protection": [222, 30, 30],
      "fire_alarm": [204, 0, 51],
      "electrical": [250, 212, 40],
      "site": [176, 188, 164]
    },
    "default": [200, 200, 200],
    "source": "the BIM view's trade colour table (bimlook TRADES), so the phone matches the desktop's 3D view"
  },
  "kind_trades": [
    {"kind": "plumbing", "trade": "plumbing", "system": "fixtures", "source": "a plumbing fixture is plumbing whatever layer its symbol sits on"},
    {"kind": "sprinkler", "trade": "fire_protection", "system": "fire", "source": "sprinkler heads are fire protection"},
    {"kind": "fire_alarm", "trade": "fire_alarm", "system": "fire_alarm", "source": "fire alarm devices are their own trade and system (NFPA 72), shown apart from power"}
  ],
  "set": {
    "_comment": "bim.export.ar {set: true, dir} (Q6420): the whole building as the field app's four views, never one package with everything. Words match whole words of an element's part, kind, tag, category, type and layer, in order. A job overrides any key under `ar_export.set`.",
    "max_triangles": 150000,
    "max_bytes": 50000000,
    "architectural_parts": ["wall", "floor", "roof", "cricket", "parapet", "curtainwall", "glass", "window", "door", "railing", "stair"],
    "box_parts": ["window", "door"],
    "mep_context_parts": ["floor"],
    "level_cut_ft": 4.0,
    "cut_parts": ["wall", "door", "window", "glass", "curtainwall", "railing", "column"],
    "overhead_parts": ["ceiling", "soffit", "grid", "roof", "cricket", "parapet", "roof-drain"],
    "groups": [
      {"group": "furniture", "classes": ["architecture", "equipment"], "words": ["furniture", "furnishing", "furnishings", "bed", "chair", "sofa", "desk", "table", "dresser", "nightstand", "wardrobe", "armoire", "bench", "ottoman"], "trades": ["furniture"], "default_on": false},
      {"group": "cabinets", "classes": ["architecture", "equipment"], "words": ["casework", "cabinet", "cabinets", "millwork", "countertop", "vanity"], "trades": ["cabinets"]},
      {"group": "electrical", "classes": ["equipment", "gear"], "words": ["panel", "panelboard", "switchboard", "switchgear", "transformer", "xfmr", "disconnect", "safety switch", "generator", "transfer switch", "meter", "meter center", "ups", "inverter", "lighting control"]},
      {"group": "plumbing", "classes": ["equipment", "plumbing_equipment"], "words": ["water heater", "booster pump", "domestic water", "grease interceptor", "sump pump", "sewage ejector"]},
      {"group": "mechanical", "trades": ["mechanical", "fire_protection"]},
      {"group": "electrical", "trades": ["electrical", "fire_alarm"]},
      {"group": "plumbing", "trades": ["plumbing"]},
      {"group": "base", "trades": ["architecture", "structure", "site"]}
    ],
    "equipment": {
      "gear_words": ["switchboard", "switchgear", "transformer", "xfmr", "generator", "transfer switch", "ats", "substation", "main distribution", "distribution board", "meter center", "unit substation", "bus duct", "busway"],
      "panel_words": ["panel", "panelboard", "load center", "loadcenter"],
      "disconnect_words": ["disconnect", "safety switch"],
      "big_words": ["air handling unit", "air handler", "ahu", "rtu", "rooftop unit", "roof top unit", "dedicated outdoor air", "doas", "erv", "energy recovery", "makeup air", "make up air", "chiller", "boiler", "cooling tower", "condensing unit", "pump", "fire pump", "booster pump", "jockey pump"],
      "min_extent_ft": 4,
      "fan_words": ["fan", "exhaust fan", "ef"],
      "device_words": ["junction", "junction box", "contactor", "starter", "relay", "time clock", "pull box", "power box", "exit sign", "door holder", "control module", "monitor module", "antenna", "charging station", "receptacle", "drain", "hydrant", "pole"],
      "full_words": ["damper", "fan coil", "fcu", "vav", "terminal unit", "unit heater", "cabinet heater", "split system", "heat pump", "air conditioner", "condenser", "humidifier", "unit ventilator", "coil", "fan powered box", "water heater", "expansion tank", "backflow"],
      "support_words": ["curb", "roof curb", "stand", "equipment stand", "pad", "housekeeping pad", "rack", "support"]
    },
    "runs": {
      "feeder_words": ["feeder", "feeders", "service", "service entrance"],
      "branch_words": ["bda", "data", "telecom", "tel", "tv", "catv", "security", "access control", "av", "nurse call", "low voltage", "lv", "signal", "communications"]
    },
    "sizes": {
      "main_duct_in": 18,
      "main_pipe_in": 3,
      "plumbing_min_in": 2,
      "fire_main_in": 2.5,
      "feeder_min_in": 1
    },
    "elevator": {
      "words": ["elevator", "elev", "lift", "hoistway"],
      "machine_words": ["machine", "controller", "control panel"],
      "branch_words": ["elevator", "elev", "cab", "hoistway", "pit", "traveling cable", "machine room"],
      "reach_ft": 15
    },
    "crossing": {
      "kinds": ["duct", "pipe", "conduit", "cable", "tray"],
      "tolerance_ft": 0.25
    },
    "outline_bar_in": 2,
    "source": "the owner's four views (11-09): Architectural (rooms, walls, windows, doors, floors, roof, stairs); MEP, mains and big gear by default, Full MEP on top (every duct, air terminal and exhaust fan; plumbing 2 in and up; fire mains and risers; every panel with its feeder; anything through a floor; never branch circuits, devices, fixtures, sprinkler heads or branch lines, nor an elevator's own branches); Floor (one level, its panels, lights, heads and branch lines); Room (everything in the room, furniture off by default). Sizes are the BIM view's main/branch limits: main ducts 18 in and mains 3 in (fidelity.json), plumbing to 2 in, sprinkler mains 2-1/2 in (branch lines commonly run to 2 in), a raceway of unknown connection 1 in and up is a feeder"
  },
  "scope": {
    "room_margin_ft": 1.0,
    "entry_probe_ft": [0.5, 1.5, 3.0],
    "source": "an element belongs to a room when its plan box comes within the margin of the room's outline (devices sit on the wall face, the wall straddles it); a door is a room's entry when a probe this far past its far face lands in another room or outside"
  }
}
